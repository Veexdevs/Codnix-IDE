# ===== CODNIX IDE - Variaveis de ambiente =====
# Copie este arquivo para .env.local (desenvolvimento) ou configure no provedor de deploy.

# Chave da API do OpenRouter (server-side; nunca exposta ao navegador).
# Voce tambem pode definir a chave pela tela Configuracoes do CODNIX (armazenamento seguro server-side).
OPENROUTER_API_KEY=

# Supabase (persistencia de projetos/conversas/configuracoes server-side). Opcional:
# se nao definir, os dados ficam em armazenamento local de arquivos (diretorio data/).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_API_KEY=sb_publishable_...

# Publico (client-side):
# URL base da API quando o frontend roda em app nativo apontando para o backend publicado.
NEXT_PUBLIC_API_BASE_URL=
